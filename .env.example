# Paste real values into RadArt/.env (copy this file). Keys are never committed.
#
# GEMINI_API_KEY — free tier via Google AI Studio: https://aistudio.google.com/apikey
# YOUTUBE_API_KEY — YouTube Data API v3 (official):
#   Overview: https://developers.google.com/youtube/v3/getting-started
#   search.list: https://developers.google.com/youtube/v3/docs/search/list
#   Enable API: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Each search.list costs 100 quota units/day (default project budget often 10,000). Tune:
# YOUTUBE_MAX_SEARCH_QUERIES_PER_RUN=5
# OPENAI_API_KEY — https://platform.openai.com/api-keys
#
OPENAI_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_MAX_SEARCH_QUERIES_PER_RUN=5
# SerpApi — Google Trends + Google Search discovery: https://serpapi.com/
SERPAPI_API_KEY=
SERPAPI_GOOGLE_TRENDS_GEO=TN
SERPAPI_GOOGLE_TRENDS_HL=fr
SERPAPI_GOOGLE_TRENDS_DATE=today 3-m
SERPAPI_GOOGLE_TRENDS_MAX_REQUESTS_PER_RUN=2
SERPAPI_GOOGLE_TRENDS_INCLUDE_TIMESERIES=false
# Social search discovery budget (site:tiktok.com / instagram / facebook) — metadata only
SEARCH_DISCOVERY_MAX_QUERIES_PER_RUN=6
# Optional separate key; falls back to SERPAPI_API_KEY
SEARCH_DISCOVERY_API_KEY=
# Google Trends official API (alpha / invite-only)
GOOGLE_TRENDS_API_KEY=
# Meta Graph — pages you manage / customer authorizes (never scrape)
# https://developers.facebook.com/docs/graph-api/
META_PAGE_ACCESS_TOKEN=
META_PAGE_IDS=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Flip only after Meta App Review grants the feature
META_IG_HASHTAG_ENABLED=false
META_IG_BUSINESS_DISCOVERY_ENABLED=false
META_PAGE_PUBLIC_CONTENT_ENABLED=false
# TikTok Display API — authorized user videos only (not FYP / Research Tools)
# https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=
ENABLE_EXPERIMENTAL_COLLECTORS=false
COLLECTION_INTERVAL_MINUTES=15
# REQUESTS_VERIFY_SSL=false
# DATABASE_PATH=backend/data/radart.db
CORS_ORIGINS=*
